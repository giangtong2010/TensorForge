#pragma once
#include "tensor.hpp"
#include "Dtype.hpp"
#include "_tensor_iterator.hpp"

{% for op in operators %}
{% for backend in backends %}
{% if backend == "XPU" %}
{% for dtype in dtypes %}

namespace xpu {
    {% if op.name == "contiguous" or op.name == "matmul" %}
    template <typename T>
    void kernel_{{ op.name }}_{{ backend }}(const at::Tensor&, const at::Tensor&, at::Tensor&);
    {% elif op.name == "copy" %}
    template <typename T>
    void kernel_{{ op.name }}_{{ backend }}(at::Tensor&, const at::Tensor&);
    {% elif op.name == "cpymem" %}
    template <typename T>
    void kernel_{{ op.name }}_{{ backend }}(void*, const void*, cpp20::Dtype, const size_t);
    {% elif op.name == "copy_from_host" %}
    template <typename T>
    void kernel_{{ op.name }}_{{ backend }}(void*, const void*, cpp20::Dtype, const size_t);
    {% else %}
    template <typename T>
    void kernel_{{ op.name }}_{{ backend }}(const at::TensorIterator& iter);
    {% endif %}
}

{% if op.name != "copy" and op.name != "cpymem" and op.name != "copy_from_host" %}
inline at::Tensor {{ op.name }}_{{ backend }}_{{ dtype.name }}(const at::Tensor& a, const at::Tensor& b) {
    {% if op.name != "contiguous" and op.name != "matmul" %}
    at::TensorIterator iter;
    iter.add_input(a);
    iter.add_input(b);
    iter.infer();

    at::Tensor c = at::Tensor::empty(iter.get_commo_shape(), iter.get_out_dtype(), a.get_device());
    iter.add_output(c);

    iter.build();

    using type = cpp20::DtypeToCPPType<cpp20::Dtype::{{ dtype.name }}>::type;
    xpu::kernel_{{ op.name }}_{{ backend }}<type>(iter);
    return c;

    {% else %}
    at::Tensor c;
    using type = cpp20::DtypeToCPPType<cpp20::Dtype::{{ dtype.name }}>::type;
    xpu::kernel_{{ op.name }}_{{ backend }}<type>(a, b, c);
    return c;

    {% endif %}
};
{% elif op.name == "cpymem" %}
inline void {{ op.name }}_{{ backend }}_{{ dtype.name }}(void* dst, const void* src, cpp20::Dtype dtype, const size_t size) {
    using type = cpp20::DtypeToCPPType<cpp20::Dtype::{{ dtype.name }}>::type;
    xpu::kernel_{{ op.name }}_{{ backend }}<type>(dst, src, dtype, size);
}
{% elif op.name == "copy_from_host" %}
inline void {{ op.name }}_{{ backend }}_{{ dtype.name }}(void* dst, const void* src, cpp20::Dtype dtype, const size_t numel) {
    using type = cpp20::DtypeToCPPType<cpp20::Dtype::{{ dtype.name }}>::type;
    xpu::kernel_{{ op.name }}_{{ backend }}<type>(dst, src, dtype, numel);
}
{% else %}
inline void {{ op.name }}_{{ backend }}_{{ dtype.name }}(at::Tensor& dst, const at::Tensor& src) {
    using type = cpp20::DtypeToCPPType<cpp20::Dtype::{{ dtype.name }}>::type;
    xpu::kernel_{{ op.name }}_{{ backend }}<type>(dst, src);
}
{% endif %}

{% endfor %}
{% endif %}
{% endfor %}
{% endfor %}
