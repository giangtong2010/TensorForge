#pragma once
#include <cstdint>
#include <cstddef>
#include <stdexcept>
#include <complex>
#include <iostream>
#include <string>

namespace cpp20 {
    enum class Dtype {
        {% for dtype in dtypes %}
        {{ dtype.name }},
        {% endfor %}
        count={{ dtypes|length }},
    };

    inline size_t dtype_size(Dtype dtype) {
        switch (dtype) {
            {% for dtype in dtypes %}
            case Dtype::{{ dtype.name }}: return sizeof({{ dtype.cpp_type }});
            {% endfor %}
            
            default:
                throw std::invalid_argument("Unsupported dtype");
        }
    }

    template<cpp20::Dtype type>
    struct DtypeToCPPType;

    {% for dtype in dtypes %}
    template <>
    struct DtypeToCPPType<cpp20::Dtype::{{ dtype.name }}> {
        using type = {{ dtype.cpp_type }};
    };
    {% endfor %}

    template<typename T>
    struct CPPTypeToDtype;

    {% for dtype in dtypes %}
    template <>
    struct CPPTypeToDtype<{{ dtype.cpp_type }}> {
        static constexpr Dtype value = Dtype::{{ dtype.name }};
    };
    {% endfor %}

    inline constexpr cpp20::Dtype PROMOTION_TABLE[{{ dtypes|length }}][{{ dtypes|length }}] = {
        {% for row in promote_tab %}
        {
            {% for dtype in row %}
            Dtype::{{ dtype.name }}{% if not loop.last %}, {% endif %}
            {% endfor %}
        },
        {% endfor %}
    };

    inline cpp20::Dtype promote_dtype(cpp20::Dtype a, cpp20::Dtype b) {
        return PROMOTION_TABLE[(size_t) a][(size_t) b];
    }
}

inline std::ostream& operator<<(std::ostream& os, const cpp20::Dtype dtype) {
    switch (dtype) {
        {% for dtype in dtypes %}
        case cpp20::Dtype::{{ dtype.name }}: return os << "{{ dtype.name }}";
        {% endfor %}
    }
}
